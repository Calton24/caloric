# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Sentry Configuration (Optional - Production Error Tracking)
# Get this from: https://sentry.io/settings/projects/your-project/keys/
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/123456

# Optional: Enable Sentry in development (disabled by default)
# EXPO_PUBLIC_ENABLE_SENTRY_IN_DEV=true

# Sentry Source Map Upload (build time only)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token

# Auth providers (default OFF — enable per app)
# EXPO_PUBLIC_AUTH_GOOGLE=0
# EXPO_PUBLIC_AUTH_APPLE=0

# Required: dev / staging / prod (used in app.config, Sentry environment, and safety gates)
EXPO_PUBLIC_APP_ENV=dev

# Optional: App Profile (defaults to "caloric" in app.config when unset)
# EXPO_PUBLIC_APP_PROFILE=default

# Edamam Food Database API (NLP food parsing)
# Get these from: https://developer.edamam.com/
# EXPO_PUBLIC_EDAMAM_APP_ID=your-edamam-app-id
# EXPO_PUBLIC_EDAMAM_APP_KEY=your-edamam-app-key

# RevenueCat (public SDK key for App Store app com.calton.caloric — same key for dev/preview/prod builds)
# Get API key from: https://app.revenuecat.com → Project → API Keys
# EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-api-key
#
# RevenueCat → Supabase Edge webhook (set in Supabase Dashboard → Project Settings → Edge Functions → Secrets)
# Must match the Authorization value RevenueCat sends (store the raw token; "Bearer " is optional).
# REVENUECAT_WEBHOOK_SECRET=your_shared_webhook_secret
# Optional alias: REVENUECAT_WEBHOOK_AUTH (same value; useful if ops named it that way)
# Deploy: run `npm run supabase:deploy:revenuecat-webhook` once so the remote
# function has JWT verification OFF (RevenueCat is not a Supabase user).
# supabase/config.toml also sets verify_jwt = false for this function name.

# Paywall fallback guard (OFF by default; enable only for staging/debug emergency)
# EXPO_PUBLIC_ALLOW_PAYWALL_FALLBACK=false

# Account data audit (staging / repro): logs [AccountDataAudit] on Home + after_commit_store_snapshot in sync
# EXPO_PUBLIC_ACCOUNT_DATA_AUDIT=1
